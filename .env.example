APP_ENV=local

# MySQL (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ffms
DB_USER=root
DB_PASS=

# Browser origins allowed to call the API with credentials (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Idle session timeout in minutes
SESSION_IDLE_MIN=240

# Display currency code (amounts are stored as plain decimals)
CURRENCY=ZMW

# 1 = fetch the live 7-day forecast from Open-Meteo (free, no key); 0 = offline climatology only
WEATHER_LIVE=1

# Used only by `php bin/seed.php` for the demo accounts. Change it, or delete demo users before launch.
DEMO_PASSWORD=Farm@Demo2026
BACKUP_KEEP_DAYS=30
DB_SSL=0
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
